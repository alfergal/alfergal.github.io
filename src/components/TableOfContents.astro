---
import type { MarkdownHeading } from 'astro';
interface Props {
	headings: MarkdownHeading[];
}
const headings = Astro.props.headings.filter(
	({ depth }) => depth === 2 || depth === 3,
);
---

{headings.length >= 3 && (
	<aside class="article-toc" aria-label="Índice del artículo">
		<details open>
			<summary>En este artículo</summary>
			<nav aria-label="Índice de contenidos">
				<ol>
					{headings.map(({ slug, text, depth }) => (
						<li class:list={{ 'toc-subheading': depth === 3 }}>
							<a href={`#${slug}`}>{text}</a>
						</li>
					))}
				</ol>
			</nav>
		</details>
	</aside>
)}
