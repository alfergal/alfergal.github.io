---
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { SITE_TITLE } from '../consts';
import { palette, themeVariables } from '../data/theme';
import { profile } from '../data/profile';
interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
	noindex?: boolean;
	article?: boolean;
	published?: Date;
	updated?: Date;
}
const {
	title,
	description,
	image,
	noindex = false,
	article = false,
	published,
	updated,
} = Astro.props;
const canonicalURL = new URL(
	Astro.url.pathname === '/404/' ? '/404.html' : Astro.url.pathname,
	Astro.site,
);
const imageURL = new URL(image?.src ?? '/og-image.png', Astro.site);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="color-scheme" content="dark" />
<meta name="theme-color" content={palette.background} />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
<link rel="icon" type="image/svg+xml" sizes="any" href="/favicon.svg" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('/rss.xml', Astro.site)}
/>
<style is:inline set:html={themeVariables} />
<link rel="canonical" href={canonicalURL} />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content={profile.name} />
{noindex && <meta name="robots" content="noindex, follow" />}
<meta property="og:type" content={article ? 'article' : 'website'} />
<meta property="og:site_name" content={profile.name} />
<meta property="og:locale" content="es_ES" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageURL} />
<meta property="og:image:alt" content={image ? title : SITE_TITLE} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL} />
{published && (
	<meta property="article:published_time" content={published.toISOString()} />
)}
{updated && (
	<meta property="article:modified_time" content={updated.toISOString()} />
)}
