---
import { contactFormConfiguration } from '../data/contact-form';
import { ui, type Locale } from '../i18n';

interface Props {
	lang: Locale;
}

const { lang } = Astro.props;
const t = ui[lang];
const { endpoint, privacyNotice } = contactFormConfiguration;
---

<section class="contact-form-section" aria-labelledby="contact-form-title">
	<h2 id="contact-form-title">{t.contactFormTitle}</h2>
	{endpoint && privacyNotice ? (
		<>
			<p class="contact-privacy-notice">{privacyNotice}</p>
			<form
				class="contact-form"
				action={endpoint}
				method="POST"
				data-contact-form
				data-sending={t.contactSending}
				data-success={t.contactSuccess}
				data-failure={t.contactFailure}
			>
				<div class="contact-field">
					<label for="contact-name">{t.contactName}</label>
					<input
						id="contact-name"
						name="name"
						type="text"
						autocomplete="name"
						maxlength="120"
						required
					/>
				</div>
				<div class="contact-field">
					<label for="contact-email">{t.contactEmail}</label>
					<input
						id="contact-email"
						name="email"
						type="email"
						autocomplete="email"
						maxlength="254"
						required
					/>
				</div>
				<div class="contact-field">
					<label for="contact-subject">{t.contactSubject}</label>
					<input
						id="contact-subject"
						name="subject"
						type="text"
						maxlength="160"
						required
					/>
				</div>
				<div class="contact-field">
					<label for="contact-message">{t.contactMessage}</label>
					<textarea
						id="contact-message"
						name="message"
						rows="7"
						maxlength="10000"
						required
					></textarea>
				</div>
				<label class="contact-honeypot" aria-hidden="true">
					{t.contactSpamField}
					<input name="_gotcha" tabindex="-1" autocomplete="off" />
				</label>
				<div class="contact-form-actions">
					<button class="button-primary" type="submit">
						{t.contactSubmit}
					</button>
					<p
						class="contact-form-status"
						role="status"
						aria-live="polite"
						data-contact-status
					></p>
				</div>
			</form>
			<script src="../scripts/contact-form.ts"></script>
		</>
	) : (
		<p class="contact-form-unavailable" role="status">
			{t.contactFormUnavailable}
		</p>
	)}
</section>
