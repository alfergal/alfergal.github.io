---
import { certifications, education } from '../data/career';
import { ui, type Locale } from '../i18n';
interface Props {
	lang: Locale;
}
const { lang } = Astro.props;
const t = ui[lang];
---

<section
	class="profile-section education-section"
	aria-labelledby="education-title"
>
	<div class="section-inner">
		<h2 id="education-title">{t.education}</h2>
		<div class="education-grid">
			{education.map((entry) => (
				<article class="education-card">
					<h3>{entry.title[lang]}</h3>
					<p class="education-description">{entry.description[lang]}</p>
				</article>
			))}
		</div>

		<section
			class="certifications-block"
			aria-labelledby="certifications-title"
		>
			<h2 id="certifications-title">{t.certifications}</h2>
			<div class="certification-grid">
				{certifications.map((entry) => (
					<article class="certification-card">
						<p class="certification-issuer">{entry.issuer}</p>
						<h4>{entry.name}</h4>
					</article>
				))}
			</div>
		</section>
	</div>
</section>
