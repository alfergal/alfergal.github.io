---
interface Props {
	name?: 'arrow' | 'external';
	size?: number;
}
const { name = 'arrow', size = 20 } = Astro.props;
const paths = {
	arrow: 'M4 12h15m-6-6 6 6-6 6',
	external: 'M7 17 17 7M7 7h10v10',
};
---

<svg
	width={size}
	height={size}
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="1.5"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
>
	<path d={paths[name]} />
</svg>
