---
import { graphNodes as nodes, graphEdges as edges } from '../data/graph';
---

<elastic-graph>
	<svg
		class="graph-network"
		viewBox="0 0 520 400"
		fill="none"
		aria-hidden="true"
	>
		<g stroke="currentColor" stroke-width=".7">
			{edges.map(({ a, b, distance }) => (
				<line
					class="graph-edge"
					data-source={a.id}
					data-target={b.id}
					x1={a.x}
					y1={a.y}
					x2={b.x}
					y2={b.y}
					opacity={0.12 + Math.max(0, 1 - distance / 100) * 0.17}
				/>
			))}
		</g>
		{nodes.map((node) => (
			<g
				data-node={node.id}
				style={`--node-radius: ${node.r}px; --node-opacity: ${node.r > 3 ? '.9' : '.55'}`}
			>
				<circle
					class="graph-dot"
					cx={node.x}
					cy={node.y}
					r={node.r}
					fill={
						node.accent
							? 'var(--graph-accent)'
							: node.r > 3
								? 'var(--ink)'
								: 'currentColor'
					}
					opacity={node.r > 3 ? '.9' : '.55'}
				/>
				<circle
					class="graph-hit"
					cx={node.x}
					cy={node.y}
					r="12"
					fill="transparent"
				/>
			</g>
		))}
		<g class="graph-effects" aria-hidden="true" />
	</svg>
</elastic-graph>

<script>
	import '../scripts/graph-network';
</script>

<style>
	elastic-graph {
		display: block;
	}
	.graph-network {
		touch-action: pan-y pinch-zoom;
	}
	.graph-network:focus-visible {
		outline: none;
	}
	.graph-hit {
		pointer-events: none;
	}
	.graph-network[data-ready] .graph-hit {
		pointer-events: all;
		touch-action: none;
	}
	.graph-network[data-near-node] {
		cursor: grab;
	}
	.graph-network[data-dragging] {
		cursor: grabbing;
	}
	.graph-dot {
		r: var(--node-radius);
		opacity: var(--node-opacity);
		transition:
			r 160ms ease,
			opacity 160ms ease;
		pointer-events: none;
	}
	[data-active] .graph-dot,
	[data-pressed] .graph-dot {
		r: calc(var(--node-radius) * 1.25);
		opacity: 1 !important;
	}
	.graph-edge {
		transition:
			stroke 160ms ease,
			opacity 160ms ease;
	}
	.graph-edge[data-active] {
		stroke: var(--accent);
		opacity: 0.48 !important;
	}
	.graph-network[data-keyboard] [data-selected] .graph-hit {
		stroke: var(--accent);
		stroke-width: 1.25;
		vector-effect: non-scaling-stroke;
	}
	.graph-effects,
	:global(.graph-ambient) {
		pointer-events: none;
	}
	@media (prefers-reduced-motion: reduce) {
		.graph-dot,
		.graph-edge {
			transition: none;
		}
		[data-active] .graph-dot,
		[data-pressed] .graph-dot {
			r: var(--node-radius);
			filter: none;
		}
	}
</style>
