---
interface Props {
	title: string;
	description: string;
	data: { label: string; value: number }[];
}
const { title, description, data } = Astro.props;
if (data.some(({ value }) => !Number.isFinite(value) || value < 0)) {
	throw new Error('BarChart requires finite, non-negative values.');
}
const maximum = Math.max(1, ...data.map(({ value }) => value));
const accessibleDescription = `${title}. ${description} ${data.map(({ label, value }) => `${label}: ${value}`).join('; ')}.`;
---

<div class="bar-chart" role="img" aria-label={accessibleDescription}>
	<div aria-hidden="true">
		<p class="chart-title">{title}</p>
		{data.map(({ label, value }) => (
			<div class="chart-row">
				<span>{label}</span>
				<svg viewBox="0 0 100 20" preserveAspectRatio="none" focusable="false">
					<rect width="100" height="20" fill="var(--line)" />
					<rect
						width={(value / maximum) * 100}
						height="20"
						fill="var(--accent)"
					/>
				</svg>
				<span>{value}</span>
			</div>
		))}
	</div>
</div>
