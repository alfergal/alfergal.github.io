---
import { localeFromPath, type Locale } from '../i18n';
interface Props {
	date: Date;
	lang?: Locale;
}

const { date, lang = localeFromPath(Astro.url.pathname) } = Astro.props;
---

<time datetime={date.toISOString()}>
	{date.toLocaleDateString(lang === 'en' ? 'en-GB' : 'es-ES', {
		timeZone: 'UTC',
		year: 'numeric',
		month: 'short',
		day: 'numeric',
	})}
</time>
