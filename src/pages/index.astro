---
import SiteLayout from '../layouts/SiteLayout.astro';
import GraphNetwork from '../components/GraphNetwork.astro';
import ProfessionalLinks from '../components/ProfessionalLinks.astro';
import PostFeed from '../components/PostFeed.astro';
import { profile } from '../data/profile';
import { getPosts } from '../lib/content';

const posts = await getPosts({ includeDrafts: import.meta.env.DEV });
---

<SiteLayout noindex={import.meta.env.DEV}>
	<section class="hero container" aria-labelledby="hero-title">
		<div class="hero-grid">
			<div>
				<h1 id="hero-title" class="text-balance">
					{profile.name}
				</h1>
				<p class="hero-role">{profile.role}</p>
				<p class="hero-description text-pretty">{profile.heroSummary}</p>
			</div>
			<div class="hero-art">
				<GraphNetwork />
			</div>
		</div>
		<div class="hero-links">
			<ProfessionalLinks />
		</div>
	</section>
	<section
		id="blog"
		class="blog-section container"
		aria-labelledby="blog-title"
	>
		<header class="blog-heading">
			<h2 id="blog-title">Blog</h2>
			<p>{profile.blogIntroduction}</p>
		</header>
		{posts.length > 0 ? (
			<PostFeed posts={posts} />
		) : (
			<p class="blog-empty">Todavía no hay artículos publicados.</p>
		)}
	</section>
</SiteLayout>
