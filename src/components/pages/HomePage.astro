---
import SiteLayout from '../../layouts/SiteLayout.astro';
import GraphNetwork from '../GraphNetwork.astro';
import PostCard from '../PostCard.astro';
import ExperienceSection from '../ExperienceSection.astro';
import EducationSection from '../EducationSection.astro';
import { profile } from '../../data/profile';
import { getPosts } from '../../lib/content';
import { ui, blogPath, type Locale } from '../../i18n';
interface Props {
	lang: Locale;
}
const { lang } = Astro.props;
const t = ui[lang];
const posts = (
	await getPosts({ lang, includeDrafts: import.meta.env.DEV })
).slice(0, 3);
---

<SiteLayout
	title={t.home + ': ' + t.role}
	lang={lang}
	noindex={import.meta.env.DEV}
>
	<section class="hero container" aria-labelledby="hero-title">
		<div class="hero-grid">
			<div>
				<h1 id="hero-title" class="text-balance">
					{profile.name}
				</h1>
				<p class="hero-role">{t.role}</p>
				<p class="hero-description text-pretty">{t.intro}</p>
				<p class="hero-description text-pretty">{t.introInterests}</p>
				<p class="hero-description text-pretty">{t.introBlog}</p>
			</div>
			<div class="hero-art">
				<GraphNetwork />
			</div>
		</div>
	</section>
	<div class="professional-content">
		<ExperienceSection lang={lang} />
		<EducationSection lang={lang} />
		<section
			id="blog"
			class="profile-section latest-articles"
			aria-labelledby="latest-title"
		>
			<div class="section-inner">
				<div class="section-heading">
					<h2 id="latest-title">{t.latest}</h2>
					<a class="text-link" href={blogPath(lang)}>
						{t.allArticles}
					</a>
				</div>
				{posts.length ? (
					<div class="post-list">
						{posts.map((post) => (
							<PostCard post={post} />
						))}
					</div>
				) : (
					<p class="blog-empty">{t.empty}</p>
				)}
			</div>
		</section>
	</div>
</SiteLayout>
