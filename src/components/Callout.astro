---
import { ui, localeFromPath } from '../i18n';
const labels = ui[localeFromPath(Astro.url.pathname)].callouts;
interface Props {
	type?: keyof typeof labels;
	title?: string;
}
const { type = 'note', title } = Astro.props;
---

<aside class="callout" data-kind={type} aria-label={title ?? labels[type]}>
	<p class="callout-title">{title ?? labels[type]}</p>
	<slot />
</aside>
