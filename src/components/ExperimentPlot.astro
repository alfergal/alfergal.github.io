---
import { readFile } from 'node:fs/promises';
import { resolve } from 'node:path';

interface Props {
	figure:
		| '01-serie-autocorrelacion'
		| '02-limite-predictor-optimo'
		| '03-error-lineal-no-lineal'
		| '04-precision-coste'
		| '01-estrategias-kirchhoff'
		| '02-matriz-resistencias';
	experiment?: 'arima-transformers' | 'resistencia-efectiva';
	alt: string;
}

const { figure, experiment = 'arima-transformers', alt } = Astro.props;
const allowedFigures = {
	'arima-transformers': [
		'01-serie-autocorrelacion',
		'02-limite-predictor-optimo',
		'03-error-lineal-no-lineal',
		'04-precision-coste',
	],
	'resistencia-efectiva': [
		'01-estrategias-kirchhoff',
		'02-matriz-resistencias',
	],
} as const;
if (!(allowedFigures[experiment] as readonly string[]).includes(figure)) {
	throw new Error(`Unknown ${experiment} figure: ${figure}`);
}
const path = resolve(
	process.cwd(),
	'experiments',
	experiment,
	'figures',
	`${figure}.svg`,
);
let svg = await readFile(path, 'utf8');
svg = svg
	.replace(/<\?xml[^>]*>\s*/i, '')
	.replace(/<!DOCTYPE[^>]*>\s*/i, '')
	.replace('<svg ', '<svg aria-hidden="true" focusable="false" ');
const ids = [...svg.matchAll(/\bid="([^"]+)"/g)].map((match) => match[1]);
for (const id of ids) {
	const prefixed = `${figure}-${id}`;
	svg = svg
		.replaceAll(`id="${id}"`, `id="${prefixed}"`)
		.replaceAll(`url(#${id})`, `url(#${prefixed})`)
		.replaceAll(`href="#${id}"`, `href="#${prefixed}"`)
		.replaceAll(`xlink:href="#${id}"`, `xlink:href="#${prefixed}"`);
}
---

<div
	class="experiment-plot"
	role="img"
	aria-label={alt}
	tabindex="0"
	set:html={svg}
/>

<style>
	.experiment-plot {
		max-width: 100%;
		overflow-x: auto;
	}

	.experiment-plot :global(svg) {
		display: block;
		width: 100%;
		min-width: 640px;
		height: auto;
	}

	.experiment-plot:focus-visible {
		outline: 2px solid var(--highlight);
		outline-offset: 4px;
	}
</style>
